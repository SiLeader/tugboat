apiVersion: v1
kind: Ship
metadata:
  name: demo-b
  namespace: {{ namespace }}
spec:
  image: {{ image }}
  shipClass: tugboat-demo-small
  networkClassRef:
    - apiGroup: core
      kind: ClusterNetworkClass
      name: cluster-network
  affinity:
    nodeAffinity:
      requiredDuringScheduling:
        nodeSelectorTerms:
          - matchExpressions:
              - key: topology.tugboat.cloud/host
                operator: In
                values:
                  - {{ worker_b }}
